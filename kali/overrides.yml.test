---
# =========================================================================== #
# TEST FILE ONLY! It is recommended that you copy the defaults.yml file to
# overrides.yml and comment out or modify values as desired.
# =========================================================================== #

# If false, the shell provisioners will run as the vagrant user
run_as_root: false

vm_name:          hdub-tech-kali-override
hostname:         hdub-tech-kali-override
# set to "disabled" to skip creation
bridged_adapter:  disabled

# The following will map to /vagrant in the VM
local_shared_dir: ../

# Only tested with bash/zsh
preferred_shell:  zsh

# These will be installed as root regardless of run_as_root setting
# Note: The Python dependencies will already be installed for you
apt_packages:
  - bc
  #- ghidra
  #- ghidra-dbgsym
  #- git-delta
  - jq
  #- meld
  #- podman
  #- procyon-decompiler
  #- shellcheck
  #- strace
  - tree
  - vim

# The directory to run git clone in...
git_repos_dir: /home/vagrant/git
# ...and the projects to clone there
git_repos:
  # Pairs with pipx_projects below to install impacket
  - https://github.com/fortra/impacket
  # Pairs with sdkman in curl_bash_projects below and relevant sections of
  # custom_setup_script below to setup cfr
  - https://github.com/leibnitz27/cfr
  - https://github.com/ly4k/Certipy

# The version of Python to install with pyenv and set as the pyenv global default
python_version: 3.12
# Packages to install with pip into pyenv $python_version (pip and pipx already
# installed and upgraded)
pip_packages:
  - boto3
  - setuptools
# Full path to projects to install with pipx using pyenv $python_version
# $git_repos_dir and $apps_dir variables supported
pipx_projects:
  - "$git_repos_dir/impacket"

# The directory to run wget and decompress/dpkg in...
apps_dir: /home/vagrant/apps
# ...and the urls to use for it
compressed_app_urls:
  - https://cdn.binary.ninja/installers/binaryninja_free_linux.zip
  #- https://download.jetbrains.com/idea/ideaIC-2025.1.3.tar.gz
  - https://web9001.nomachine.com/download/9.1/Linux/nomachine_9.1.24_6_amd64.deb

# Projects to install with curl | bash light help me
curl_bash_projects:
  # Pairs with relevant sections of custom_setup_script below to setup sdkman
  # and install a version of Java
  - https://get.sdkman.io

# Put your commands here to install project dependencies and set your nicities.
# This script has access to $git_repos_dir and $apps_dir variables.
# This will run as root if $run_as_root=true, else as vagrant user.
custom_setup_script: |
  set -e                           # Exit on error
  echo -n "==> INFO: Running custom_setup_script as " && whoami

  echo "==> INFO: Set-up java utilities (sdkman, java, maven)"
  export SDKMAN_DIR="$HOME/.sdkman"
  [[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"
  sdk install java 11.0.27-zulu  # Need older version for cfr compilation
  sdk install maven

  echo "==> INFO: Set-up https://github.com/leibnitz27/cfr and test"
  cd "${git_repos_dir}/cfr"
  mvn compile
  java -cp target/classes org.benf.cfr.reader.Main java.lang.Object

  echo "==> INFO: Add non-versioned IntelliJ symlink to be used with desktop shortcut"
  idea_symlink="${apps_dir}/idea"
  [ ! -L "${idea_symlink}" ] \
    && find "${apps_dir}" -type d -name 'idea-IC*' \
       -exec sudo ln -s {} "${idea_symlink}" \; \
       -exec sh -c 'sudo chown --no-dereference "$(stat -c "%U:%G" "$1")" "$2"' sh {} "${idea_symlink}" \;

  echo "==> INFO: Download BinaryNinja icon to be used with desktop shortcut"
  wget https://binary.ninja/icons/android-chrome-512x512.png --output-document "${apps_dir}/binaryninja/binaryninja.png"

  echo "==> INFO: Install netbird and netbird-ui, if not already"
  which netbird || curl -fsSL https://pkgs.netbird.io/install.sh | sh
  # For some reason install script does not detect desktop environment
  sudo apt-get --yes install netbird-ui

  echo "==> INFO: Install tailscale, if not already"
  which tailscale || curl -fsSL https://tailscale.com/install.sh | sh

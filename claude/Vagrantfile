# Podman and Podman Compose setup script
$podmans_setup_script = <<~PODMAN_SCRIPT
  set -e                           # Exit on error

  INSTALL_PODMAN_VERSION=
  cd "#{$git_repos_dir}/podman"
  if [ -n "#{$podman_version}" ]; then
    INSTALL_PODMAN_VERSION="v#{$podman_version}"
  else
    # Get most recent non pre-release version
    INSTALL_PODMAN_VERSION="$( git --no-pager tag | grep -v ".*-.*" | sort --version-sort | tail -n1 )"
  fi
  echo "\n========= Checking out podman version (${INSTALL_PODMAN_VERSION}) ========="
  git checkout "${INSTALL_PODMAN_VERSION}"

  GO_VERSION="$( grep "^go" "#{$git_repos_dir}"/podman/go.mod | cut -d' ' -f2 )"
  echo "\n========= Installing go version (${GO_VERSION}) and updating vagrant user PATH ========="
  GO_URL="https://go.dev/dl/go${GO_VERSION}.linux-amd64.tar.gz"
  GO_ZIP="/tmp/$( basename "${GO_URL}" )"
  GOROOT=/usr/local/go
  wget --no-verbose --output-document="${GO_ZIP}" "${GO_URL}"
  [ -e "${GOROOT}" ] && sudo rm -r "${GOROOT}"
  sudo tar -C "$( dirname ${GOROOT} )" -xzf "${GO_ZIP}"
  #sudo ln -s "${GOROOT}"/bin/go /usr/local/bin/go  # adds go to sudo secure_path

  CUSTOMRC="${HOME}/.customrc"
  echo "\n========= Setup ${CUSTOMRC} exports, etc. ========="
  cat <<-CUSTOMRC_DOC | tee "${CUSTOMRC}"  # Deliberate no -a
	export DOCKER_HOST=unix://#{$podman_socket}
	export GOROOT=${GOROOT}
	export PATH=\\$GOROOT/bin:\\$PATH
	alias markdownlint-cli2='podman run --rm -v .:/workdir docker.io/davidanson/markdownlint-cli2:v0.22.1'
	alias dockerlint='podman run --rm -i docker.io/hadolint/hadolint:v2.14.0'
	alias hadolint=dockerlint
	# Always start in the project/mounted dir at login
	cd #{$vm_mountpoint}
  CUSTOMRC_DOC
  if ! grep "${CUSTOMRC}" ~/.bashrc; then echo ". ${CUSTOMRC}" | tee -a ~/.bashrc; fi
  # shellcheck source=/dev/null
  . "${CUSTOMRC}"

  echo "\n========= Setup conmon ========="
  cd #{$git_repos_dir}/conmon
  GOCACHE="$( mktemp -d )"
  export GOCACHE
  make
  sudo make podman

  echo "\n========= Add configurations to /etc/containers ========="
  sudo mkdir -p /etc/containers
  REGISTRY_CONF=/etc/containers/registries.conf
  POLICY_CONF=/etc/containers/policy.json
  if [ ! -e "${REGISTRY_CONF}" ]; then
    sudo curl --location --no-clobber --output "${REGISTRY_CONF}" https://raw.githubusercontent.com/containers/image/main/registries.conf
  fi
  if [ ! -e "${POLICY_CONF}" ]; then
    sudo curl --location --no-clobber --output "${POLICY_CONF}" https://raw.githubusercontent.com/containers/image/main/default-policy.json
  fi

  LOCALE="en_US.UTF-8"
  echo "\n========= Reconfigure Locale (${LOCALE}) so 'make docs' will work ========="
  sudo sed -i -e "s/# \\(${LOCALE} UTF-8\\)/\\1/" /etc/locale.gen  # uncomment US locale
  echo "LANG=${LOCALE}" | sudo tee /etc/default/locale
  sudo locale-gen

  echo "\n========= Build podman from source, if not present at ${INSTALL_PODMAN_VERSION}  ========="
  if ! which podman &>/dev/null || [[ "v$(podman --version | cut -d' ' -f3)" != "${INSTALL_PODMAN_VERSION}" ]]; then
    cd "#{$git_repos_dir}/podman"
    make BUILDTAGS="seccomp"
    sudo env PATH=$PATH make install

    echo "\n========= Update AppArmor to workaround containers/podman#24642 error on first run ========="
    sudo sed -i 's!/usr/bin/podman!/usr/{bin,local/bin}/podman!' /etc/apparmor.d/podman
    sudo systemctl reload apparmor.service
  else
    echo "...Podman already installed at ${INSTALL_PODMAN_VERSION}."
  fi
  podman --version

  echo "\n========= Build pasta from source because OS version is too old ========="
  INSTALL_PASTA_VERSION=
  PASTA_DIR="#{$git_repos_dir}/passt"
  cd "${PASTA_DIR}"
  if [ -n "#{$pasta_version}" ]; then
    INSTALL_PASTA_VERSION="#{$pasta_version}"
  else
    # Get most recent versoin
    INSTALL_PASTA_VERSION="$( git --no-pager tag | sort | tail -n1 )"
  fi
  echo "\n========= Checking out passt version (${INSTALL_PASTA_VERSION}) ========="
  git checkout "${INSTALL_PASTA_VERSION}"

  echo "\n========= Build and install pasta to /usr/local/bin ========="
  PASTA_TARGET=/usr/local/bin/pasta
  PASTA_BUILD="${PASTA_DIR}"/pasta
  make
  if [[ ! -L "${PASTA_TARGET}" ]] || [[ "$( readlink "${PASTA_TARGET}" )" != "${PASTA_BUILD}" ]]; then
    sudo ln -f -s "${PASTA_BUILD}" "${PASTA_TARGET}"
  fi
  which pasta
  pasta --version

  INSTALL_PODMAN_COMPOSE_VERSION=
  cd "#{$git_repos_dir}/podman-compose"
  if [ -n "#{$podman_compose_version}" ]; then
    INSTALL_PODMAN_COMPOSE_VERSION="v#{$podman_compose_version}"
  else
    # Get most recent non pre-release version
    INSTALL_PODMAN_COMPOSE_VERSION="$( git --no-pager tag | grep -v ".*-.*" | sort --version-sort | tail -n1 )"
  fi

  if ! which podman-compose &>/dev/null || [[ "v$( podman-compose --version 2>/dev/null | tail -n1 | cut -d' ' -f3)" != "${INSTALL_PODMAN_COMPOSE_VERSION}" ]]; then
    echo "\n========= Checking out podman-compose version (${INSTALL_PODMAN_COMPOSE_VERSION}) ========="
    git checkout "${INSTALL_PODMAN_COMPOSE_VERSION}"
    #### TEMP HACK UNTIL I SUBMIT FIX TO PODMAN COMPOSE ####
    REG_CONF_D_DIR=/etc/containers/registries.conf.d
    if [ ! -a "${REG_CONF_D_DIR}/shortnames.conf" ]; then
      sudo mkdir -p "${REG_CONF_D_DIR}"
      echo "[aliases]\n  # python\n  \\"python\\" = \\"docker.io/library/python\\"\n" | sudo tee "${REG_CONF_D_DIR}/shortnames.conf"
    fi
    #### END HACK ####
    sh "#{$git_repos_dir}"/podman-compose/scripts/generate_binary_using_dockerfile.sh
    sudo cp "#{$git_repos_dir}"/podman-compose/podman-compose /usr/local/bin/podman-compose
  else
    echo "\n...Podman Compose already installed at ${INSTALL_PODMAN_COMPOSE_VERSION}."
  fi
  podman-compose version

  echo "\n========= Enable and Start podman.socket service =========\n"
  systemctl --user enable podman.socket
  systemctl --user start podman.socket

  DOCKER_SOCK=/var/run/docker.sock
  echo "\n========= Symlink to ${DOCKER_SOCK}, if doesn't exist =========\n"
  [[ ! -e "${DOCKER_SOCK}" ]] && sudo ln -s "#{$podman_socket}" "${DOCKER_SOCK}"

  echo "\n========= PODMAN SETUP SCRIPT COMPLETE =========\n"
PODMAN_SCRIPT

$nvm_node_setup_script = <<~NVM_NODE_SETUP_SCRIPT
  set -e                           # Exit on error

  NVM_DIR="#{$git_repos_dir}/nvm"
  cd "${NVM_DIR}"

  INSTALL_NVM_VERSION=
  if [ -n "#{$nvm_version}" ]; then
    INSTALL_NVM_VERSION="v#{$nvm_version}"
  else
    # Get most recent non pre-release version
    INSTALL_NVM_VERSION=$( git describe --abbrev=0 --tags --match "v[0-9]*" "$(git rev-list --tags --max-count=1)")
  fi

  if ! command -v nvm &>/dev/null || [[ "v$(nvm --version)" != "${INSTALL_NVM_VERSION}" ]]; then
    echo "\n========= Checking out nvm version (${INSTALL_NVM_VERSION}) ========="
    git checkout "${INSTALL_NVM_VERSION}"

    CUSTOMRC="${HOME}/.customrc"
    echo "\n========= Setup ${CUSTOMRC} for NVM ========="
    # Unquoted var to allow parameter expansion
    cat <<-CUSTOMRC_HEREDOC | tee -a "${CUSTOMRC}"
	
	#### NVM settings ####
	export NVM_DIR="${NVM_DIR}"
	[ -s "\\$NVM_DIR/nvm.sh" ] && \. "\\$NVM_DIR/nvm.sh"  # This loads nvm
	[ -s "\\$NVM_DIR/bash_completion" ] && \. "\\$NVM_DIR/bash_completion"  # This loads nvm bash_completion

	alias buninstall='bun install --verbose'
	alias bunupdate='bun update --verbose'
	CUSTOMRC_HEREDOC
    # shellcheck source=/dev/null
    . "${CUSTOMRC}"
  else
    echo "\n...NVM already installed at ${INSTALL_NVM_VERSION}."
  fi
  nvm --version

  INSTALL_NODE_VERSION=
  # shellcheck disable=SC2157
  if [ -n "#{$node_version}" ]; then
    INSTALL_NODE_VERSION="#{$node_version}"
    echo "\n========= Installing REQUESTED node version (${INSTALL_NODE_VERSION}) ========="
  else
    INSTALL_NODE_VERSION="$(nvm ls-remote --no-colors  | tail -n1 | grep -o \"[0-9.]*\")"
    echo "\n========= Installing LATEST node version (${INSTALL_NODE_VERSION}) ========="
  fi

  if ! command -v node &>/dev/null || [[ "$(node --version)" != "v${INSTALL_NODE_VERSION}" ]]; then
    nvm install --default "${INSTALL_NODE_VERSION}"
  else
    echo "\n...Node already installed at ${INSTALL_NODE_VERSION}."
  fi
  node --version

  echo "\n========= Installing Bun ========="
  npm install -g bun
  bun --version
NVM_NODE_SETUP_SCRIPT


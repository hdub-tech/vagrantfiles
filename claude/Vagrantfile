	--platform ubuntu-24.04=node:trixie
	--platform ubuntu-22.04=node:bookworm
	--platform ubuntu-20.04=node:bullseye
	--platform ubuntu-18.04=node:buster
  ACTRC_DOC
ACT_SETUP_SCRIPT

# Directories containing opinionated defaults seeded into ~/.claude/ in the VM.
# claude.defaults/ is tracked; claude.overrides/ is gitignored and optional.
# For each artifact (CLAUDE.md, settings.json, memory/), the override wins if
# present at claude.overrides/<item>; else claude.defaults/<item> is used.
# Returns nil if neither exists. Host paths are relative to this Vagrantfile.
$claude_defaults_dir = 'claude.defaults'
$claude_overrides_dir = 'claude.overrides'
def claude_source(item)
  override = "#{$claude_overrides_dir}/#{item}"
  return override if File.exist?(override)
  default = "#{$claude_defaults_dir}/#{item}"
  File.exist?(default) ? default : nil
end

$claude_md_source  = claude_source('CLAUDE.md')
$settings_source   = claude_source('settings.json')
$memory_source_dir = claude_source('memory')

# Guest staging directory the resolved defaults are copied into by the file
# provisioner. The project setup script seeds ~/.claude/ from here.
$claude_staging_dir = "/tmp/claude-staging"

# Project dependencies setup script
# Note: bootstrap.sh (https://downloads.claude.ai/claude-code-releases/bootstrap.sh),
# which is the documented way to install Claude Code, doesn't support checksum
# validation of itself, which is why we bypass it and go directly to the
# versioned installer file.
$project_setup_script = <<~PROJECT_SCRIPT
  # PUT YOUR COMMANDS HERE TO INSTALL PROJECT DEPENDENCIES AND SET YOUR NICITIES.

  CLAUDE_VERSION="#{$claude_version}"
  echo "\n========= Install Claude Code v${CLAUDE_VERSION} with SHA256 verification, if not already present ========="

  if ! which claude &>/dev/null || [[ "v$( claude --version | cut -d' ' -f1)" != "v${CLAUDE_VERSION}" ]]; then
    CLAUDE_BASE_URL="https://downloads.claude.ai/claude-code-releases/${CLAUDE_VERSION}"
    CLAUDE_TMP_BINARY="/tmp/claude-${CLAUDE_VERSION}"
    CLAUDE_SHA256="$( curl -fsSL "${CLAUDE_BASE_URL}/manifest.json" | jq -r '.platforms["linux-x64"].checksum' )"
    curl -fsSL "${CLAUDE_BASE_URL}/linux-x64/claude" -o "${CLAUDE_TMP_BINARY}"
    echo "${CLAUDE_SHA256}  ${CLAUDE_TMP_BINARY}" | sha256sum -c || {
      echo "ERROR: SHA256 checksum verification failed for Claude Code binary" >&2
      rm -f "${CLAUDE_TMP_BINARY}"
      exit 1
    }
    chmod +x "${CLAUDE_TMP_BINARY}"
    "${CLAUDE_TMP_BINARY}" install "${CLAUDE_VERSION}"
    rm -f "${CLAUDE_TMP_BINARY}"
  else
    echo "...Claude already installed at ${CLAUDE_VERSION}."
  fi

  CUSTOMRC="${HOME}/.customrc"
  echo "\n========= Setup ${CUSTOMRC} for Claude ========="
  cat <<-CUSTOMRC_DOC | tee -a "${CUSTOMRC}"
	
	#### Claude settings ####
	export CUSTOM_CLAUDE_FLAGS="IS_DEMO=1 DO_NOT_TRACK=1 CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1 CLAUDE_CODE_DISABLE_MOUSE_CLICKS=1"
	alias claude="\\${CUSTOM_CLAUDE_FLAGS} claude"
	echo "NOTE: claude aliased with the following flags (run 'unalias claude' to reset): \\${CUSTOM_CLAUDE_FLAGS}"

	alias ghauth='gh auth login -h github.com -p ssh'
  CUSTOMRC_DOC
  # shellcheck source=/dev/null
  . "${CUSTOMRC}"
  export PATH="$HOME/.local/bin:$PATH"
  claude --version

  echo "\n========= Install/Upgrade useful pip packages for some Claude related tasks ========="
  # shellcheck source=/dev/null
  . ~/.pyenvrc
  pip install --upgrade pip #{$pip_packages.join(' ')}

  # Seed opinionated user-level CLAUDE.md, settings.json, and memory files
  # from the staged defaults in $claude_staging_dir. Each seed step is guarded
  # by an existence check on the target so re-running vagrant up --provision
  # never clobbers files the user has already edited in-VM. To re-seed a
  # single artifact, delete the target inside the VM and re-provision.
  CLAUDE_STAGING_DIR="#{$claude_staging_dir}"
  USER_CLAUDE_DIR="${HOME}/.claude"
  mkdir -p "${USER_CLAUDE_DIR}"

  STAGED_CLAUDE_MD="${CLAUDE_STAGING_DIR}/CLAUDE.md"
  USER_CLAUDE_MD="${USER_CLAUDE_DIR}/CLAUDE.md"
  if [ ! -e "${USER_CLAUDE_MD}" ] && [ -e "${STAGED_CLAUDE_MD}" ]; then
    echo "\n========= Install opinionated user-level CLAUDE.md ========="
    cp "${STAGED_CLAUDE_MD}" "${USER_CLAUDE_MD}"
  else
    echo "\n========= User-level CLAUDE.md exists or staged file missing, skipping ========="
  fi

  STAGED_SETTINGS="${CLAUDE_STAGING_DIR}/settings.json"
  USER_SETTINGS="${USER_CLAUDE_DIR}/settings.json"
  if [ ! -e "${USER_SETTINGS}" ] && [ -e "${STAGED_SETTINGS}" ]; then
    echo "\n========= Install opinionated user-level settings.json ========="
    cp "${STAGED_SETTINGS}" "${USER_SETTINGS}"
  else
    echo "\n========= User-level settings.json exists or staged file missing, skipping ========="
  fi

  STAGED_MEMORY_DIR="${CLAUDE_STAGING_DIR}/memory"
  USER_MEMORY_DIR="${USER_CLAUDE_DIR}/memory"
  mkdir -p "${USER_MEMORY_DIR}"
  if [ -d "${STAGED_MEMORY_DIR}" ]; then
    echo "\n========= Seed Claude Code memory from ${STAGED_MEMORY_DIR} ========="
    for memory_file in "${STAGED_MEMORY_DIR}"/*.md; do
      [ -f "${memory_file}" ] || continue
      dest="${USER_MEMORY_DIR}/$( basename "${memory_file}" )"
      if [ ! -e "${dest}" ]; then
        cp "${memory_file}" "${dest}"
        echo "...Seeded $( basename "${memory_file}" )"
      else
        echo "...Skipped $( basename "${memory_file}" ) (already exists)"
      fi
    done
  else
    echo "\n========= No staged claude memory dir found at ${STAGED_MEMORY_DIR}, skipping ========="
  fi
PROJECT_SCRIPT

$python_packages = " curl \
  git \
  gcc \
  make \
  zlib1g-dev \
  libssl-dev \
  libffi-dev \
  libsqlite3-dev \
  libbz2-dev \
  libreadline-dev \
  liblzma-dev"
$apt_packages = $podman_packages + $python_packages + $must_have_packages
Vagrant.configure("2") do |config|

  # Name the VM after the project and Vagrant instance type
  config.vm.define "#{$project_name}-bento-ubuntu-2404" do |dbw|
    # Ubuntu 24.04 image by Chef (bento boxes)
    dbw.vm.box = "bento/ubuntu-24.04"
    # Dots might not behave as expected here
    dbw.vm.hostname = "#{$project_name.gsub('.', '-')}"
    dbw.vm.synced_folder $local_shared_dir, $vm_mountpoint
    dbw.vm.disk :disk, size: "20GB", primary: true

    # Forwarded ports
    $forwarded_ports.each do |port|
      config.vm.network "forwarded_port", guest: port[:guest], host: port[:host]
    end

    # VirtualBox configuration
    dbw.vm.provider "virtualbox" do |v|
      # UI name in VirtualBox
      v.name = "#{$project_name}-bento-ubuntu-2404"
      # Increase Video memory from low default of 33MB
      v.customize ["modifyvm", :id, "--vram", "128"]
      # Hungry hungry hippo
      v.memory = 16384
      v.cpus = 4
      # Disable Remote Display server ffs Debian
      v.customize ["modifyvm", :id, "--vrde=off"]
    end

    # Install requested apt packages
    dbw.vm.provision "Install specified apt packages [#{$apt_packages}]", type: "shell", inline: <<~APT_SCRIPT
      # Non-interactive flags
      export DEBIAN_FRONTEND=noninteractive
      # https://debian-handbook.info/browse/stable/sect.package-meta-information.html#sidebar.questions-conffiles
      # Use default confs or old confs
      apt_dpkg_opts="-o Dpkg::Options::=\"--force-confdef\" -o Dpkg::Options::=\"--force-confold\""

      # Run apt
      apt-get update
      apt-get --yes $apt_dpkg_opts upgrade
      apt-get --yes install #{$apt_packages}
    APT_SCRIPT

    # Clone specified git repos, if specified
    if $git_repos.length > 0
      dbw.vm.provision "Cloning specified git_repos to #{$git_repos_dir}", type: "shell", privileged: false, inline: <<~GIT_REPOS_SCRIPT
        set -e
        cd #{$git_repos_dir}
        for url in `echo #{$git_repos.join(' ')}`; do
          project_dir=${url##http*/}
          echo "INFO: Cloning $url to #{$git_repos_dir}/$project_dir..."
          if [ ! -d $project_dir ]; then
            git clone $url
          else
            echo "WARNING: $project_dir already exists - skipping" 1>&2
          fi
        done
      GIT_REPOS_SCRIPT
    end

    # Install and setup pyenv
    dbw.vm.provision "Install and setup pyenv", type: "shell", privileged: false, inline: <<~'PYENV_SETUP_SCRIPT'
      set -e
      # Install pyenv if not already there
      if [ ! -e ~/.pyenv ]; then
        # Split up due to noisy unnecessary stderr on both commands
        curl --silent --output /tmp/pyenv.run https://pyenv.run
        bash /tmp/pyenv.run 2>&1
      else
        echo "WARNING: ~/.pyenv exists - Skipping pyenv installation" 1>&2
      fi
      # The BASH Heredocs must use tabs: https://www.shellcheck.net/wiki/SC1040
      echo "INFO: Creating ~/.pyenrc to be sourced in ~/.bashrc with contents:"
      cat <<-'PYRC' | tee ~/.pyenvrc  # Deliberate no -a
		export PYENV_ROOT="$HOME/.pyenv"
		[[ -d $PYENV_ROOT/bin ]] && export PATH="$PYENV_ROOT/bin:$PATH"
		eval "$(pyenv init - bash)"
      PYRC
      echo "INFO: Adding 'source (.) .pyenvrc' to bashrc, only if not already there"
      if ! grep pyenvrc ~/.bashrc; then echo ". ~/.pyenvrc" | tee -a ~/.bashrc; fi
    PYENV_SETUP_SCRIPT

    # Install specified Python version using pyenv and set as global
    dbw.vm.provision "Install Python #{$python_version} and set as global default", type: "shell", privileged: false, inline: <<~PYENV_INSTALL_SCRIPT
      set -e
      . ~/.pyenvrc
      pyenv install --skip-existing #{$python_version} 2>&1
      pyenv global #{$python_version}
      pyenv version
    PYENV_INSTALL_SCRIPT

    # Run podman and podman compose setup script
    dbw.vm.provision "Run podman and podman compose setup script", type: "shell", privileged: false, inline: <<~PODMANS_SETUP_SCRIPT
      #{$podmans_setup_script}
      echo "INFO: Copying this script to #{$vm_mountpoint}/vagrant-podmans-setup.sh in case it needs to be run again, excluding this comment/cmd"
      sed -e '1i#!/usr/bin/env bash' /tmp/vagrant-shell | head -n -2 > #{$vm_mountpoint}/vagrant-podmans-setup.sh  # delib no append
    PODMANS_SETUP_SCRIPT

    # Run nvm and node setup script
    dbw.vm.provision "Run nvm and node setup script", type: "shell", privileged: false, inline: <<~NODES_SETUP_SCRIPT
      #{$nvm_node_setup_script}
      echo "INFO: Copying this script to #{$vm_mountpoint}/vagrant-nvm-node-setup.sh in case it needs to be run again, excluding this comment/cmd"
      sed -e '1i#!/usr/bin/env bash' /tmp/vagrant-shell | head -n -2 > #{$vm_mountpoint}/vagrant-nvm-node-setup.sh  # delib no append
    NODES_SETUP_SCRIPT

    # Run act setup script
    dbw.vm.provision "Run nektos/act setup script", type: "shell", privileged: false, inline: <<~ACT_SETUP_SCRIPT
      #{$act_setup_script}
      echo "INFO: Copying this script to #{$vm_mountpoint}/vagrant-act-setup.sh in case it needs to be run again, excluding this comment/cmd"
      sed -e '1i#!/usr/bin/env bash' /tmp/vagrant-shell | head -n -2 > #{$vm_mountpoint}/vagrant-act-setup.sh  # delib no append
    ACT_SETUP_SCRIPT

    # Stage resolved opinionated defaults into $claude_staging_dir. The bash
    # block in $project_setup_script seeds ~/.claude/ from the staging dir.
    [$claude_md_source, $settings_source, $memory_source_dir].each do |src|
      next unless src
      dbw.vm.provision "Stage #{src} from Vagrantfile dir",
        type: "file",
        source: src,
        destination: "#{$claude_staging_dir}/"
    end

    # Run project specific setup script
    dbw.vm.provision "Run project setup script", type: "shell", privileged: false, inline: <<~PROJECT_SETUP_SCRIPT
      #{$project_setup_script}
      echo "INFO: Copying this script to #{$vm_mountpoint}/vagrant-project-setup.sh in case it needs to be run again, excluding this comment/cmd"
      sed -e '1i#!/usr/bin/env bash' /tmp/vagrant-shell | head -n -2 > #{$vm_mountpoint}/vagrant-project-setup.sh  # delib no append
    PROJECT_SETUP_SCRIPT
  end
end
